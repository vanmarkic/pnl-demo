# Environment Configuration Example
# Copy this to .env and fill in your values

# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database (PostgreSQL)
# Option 1: Full connection URL
DATABASE_URL=postgresql://pnl_user:pnl_password@localhost:5432/pnl_demo

# Option 2: Separate components (used if DATABASE_URL not set)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=pnl_user
# POSTGRES_PASSWORD=pnl_password
# POSTGRES_DB=pnl_demo

# AWS S3 Configuration
# For local development, you can use LocalStack or leave these empty
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=eu-west-1
S3_BUCKET_NAME=pnl-demo-market-data

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
